# Supabase local dev (run `pnpm supabase start` to get these)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Postgres URLs (Supabase exposes both)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Observability (optional in dev)
SENTRY_DSN=
