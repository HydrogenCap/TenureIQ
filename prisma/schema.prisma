// TenureIQ Prisma schema — source of truth for the data model.
// RLS, triggers, helper functions are in supabase/migrations/*.sql (Prisma does not manage these).
// All money is bigint pence. All rates are int basis points. Dates without time are db.Date.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, uuid_ossp(map: "uuid-ossp")]
}

// =========================================================================
// Identity & tenancy
// =========================================================================

model Organisation {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  slug            String    @unique
  ownerUserId     String    @map("owner_user_id") @db.Uuid
  planTier        String    @default("trial") @map("plan_tier") // legacy from M0 — superseded by plan/planStatus columns (M12)
  trialEndsAt     DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  autoConfirmHighConfidenceOcr Boolean @default(false) @map("auto_confirm_high_confidence_ocr")

  // Billing (M12). plan is the source of truth for feature gating.
  // stripeCustomerId is null until the org goes through Checkout.
  plan            String    @default("free")
  planStatus      String    @default("active") @map("plan_status") // active|trialing|past_due|canceled|paused
  planRenewsAt    DateTime? @map("plan_renews_at") @db.Timestamptz(6)
  stripeCustomerId String?  @map("stripe_customer_id")

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  members         OrganisationMember[]
  subscriptions   Subscription[]
  invitations     Invitation[]
  entities        Entity[]
  bankAccounts    BankAccount[]
  properties      Property[]
  tenants         Tenant[]
  tenancies       Tenancy[]
  mortgages       Mortgage[]
  valuations      Valuation[]
  transactions    Transaction[]
  directorLoans   DirectorLoan[]
  investors       Investor[]
  capitalAccounts InvestorCapitalAccount[]
  investorTransactions InvestorTransaction[]
  complianceItems ComplianceItem[]
  maintenanceJobs MaintenanceJob[]
  tasks           Task[]
  reminders       Reminder[]
  documents       Document[]
  aascContracts   AascContract[]
  aascPlacements  AascPlacement[]
  placementCountChanges PlacementCountChange[]
  rentChanges     RentChange[]
  txCategoryRules TransactionCategoryRule[]
  txImports       TransactionImport[]
  txImportRows    TransactionImportRow[]
  contractors     Contractor[]
  maintenanceJobEvents MaintenanceJobEvent[]
  maintenanceQuotes MaintenanceQuote[]
  webhookEvents     WebhookEvent[]
  maintenanceInvoices MaintenanceInvoice[]

  @@map("organisations")
}

model User {
  // Mirror of auth.users — keeps a FK target outside the auth schema.
  id              String    @id @db.Uuid
  email           String    @unique
  displayName     String?   @map("display_name")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships     OrganisationMember[]
  invitationsSent Invitation[] @relation("InvitedBy")

  @@map("users")
}

model OrganisationMember {
  id                  String    @id @default(uuid()) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  role                String    // owner|admin|manager|accountant|viewer (CHECK at SQL level)
  acceptedAt          DateTime? @map("accepted_at") @db.Timestamptz(6)
  notifyCompliance            Boolean @default(true) @map("notify_compliance")
  notifyMortgages             Boolean @default(true) @map("notify_mortgages")
  notifyTenancies             Boolean @default(true) @map("notify_tenancies")
  notifyAasc                  Boolean @default(true) @map("notify_aasc")
  notifyContractorInsurance   Boolean @default(true) @map("notify_contractor_insurance")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation        Organisation @relation(fields: [organisationId], references: [id])
  user                User @relation(fields: [userId], references: [id])

  @@unique([organisationId, userId])
  @@map("organisation_members")
  @@index([userId])
}

model Invitation {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  email           String
  role            String
  token           String    @unique
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])
  invitedBy       User @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  @@map("invitations")
  @@index([organisationId])
  @@index([email])
}

// =========================================================================
// Property graph: entities → properties → units → tenancies
// =========================================================================

model Entity {
  id                       String    @id @default(uuid()) @db.Uuid
  organisationId           String    @map("organisation_id") @db.Uuid
  name                     String
  kind                     String    // ltd|llp|individual|spv
  companiesHouseNumber     String?   @map("companies_house_number")
  registeredAddress        String?   @map("registered_address")
  hmrcUtr                  String?   @map("hmrc_utr")
  vatNumber                String?   @map("vat_number")
  yearEndMonth             Int?      @map("year_end_month")
  yearEndDay               Int?      @map("year_end_day")
  notes                    String?

  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation             Organisation @relation(fields: [organisationId], references: [id])
  shareholders             Shareholder[]
  properties               Property[]
  bankAccounts             BankAccount[]
  capitalAccounts          InvestorCapitalAccount[]
  directorLoans            DirectorLoan[]

  @@map("entities")
  @@unique([organisationId, companiesHouseNumber])
  @@index([organisationId])
  @@index([organisationId, deletedAt])
}

model Shareholder {
  id              String    @id @default(uuid()) @db.Uuid
  entityId        String    @map("entity_id") @db.Uuid
  name            String
  shareCount      Int       @map("share_count")
  shareClass      String    @default("ordinary") @map("share_class")
  isDirector      Boolean   @default(false) @map("is_director")
  appointedDate   DateTime? @map("appointed_date") @db.Date
  resignedDate    DateTime? @map("resigned_date") @db.Date

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  entity          Entity @relation(fields: [entityId], references: [id])

  @@map("shareholders")
  @@index([entityId])
}

model BankAccount {
  id                  String    @id @default(uuid()) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  entityId            String?   @map("entity_id") @db.Uuid
  label               String
  bankName            String?   @map("bank_name")
  kind                String    @default("current") // current|savings|client_money|tenant_deposit
  accountNumberLast4  String?   @map("account_number_last4")
  sortCodeMasked      String?   @map("sort_code_masked")
  currency            String    @default("GBP")
  openingBalancePence BigInt    @default(0) @map("opening_balance_pence")
  openingBalanceDate  DateTime? @map("opening_balance_date") @db.Date
  notes               String?

  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation        Organisation @relation(fields: [organisationId], references: [id])
  entity              Entity? @relation(fields: [entityId], references: [id])
  transactions        Transaction[]

  @@map("bank_accounts")
  @@index([organisationId])
  @@index([entityId])
}

model Property {
  id                       String    @id @default(uuid()) @db.Uuid
  organisationId           String    @map("organisation_id") @db.Uuid
  entityId                 String    @map("entity_id") @db.Uuid

  addressLine1             String    @map("address_line_1")
  addressLine2             String?   @map("address_line_2")
  city                     String
  county                   String?
  postcode                 String
  localAuthority           String?   @map("local_authority")
  brmaCode                 String?   @map("brma_code")

  kind                     String    // hmo|single_let|block|commercial|development|land
  classUse                 String?   @map("class_use") // c3|c4|sui_generis|commercial
  bedroomsTotal            Int?      @map("bedrooms_total")
  bathroomsTotal           Int?      @map("bathrooms_total")
  internalAreaSqm          Decimal?  @map("internal_area_sqm") @db.Decimal(8, 2)

  // Acquisition
  purchasePricePence       BigInt    @map("purchase_price_pence")
  purchaseDate             DateTime  @map("purchase_date") @db.Date
  sdltPaidPence            BigInt?   @map("sdlt_paid_pence")
  refurbCostPence          BigInt?   @map("refurb_cost_pence")
  acquisitionCostsPence    BigInt?   @map("acquisition_costs_pence")

  // Current state
  currentValuationPence    BigInt?   @map("current_valuation_pence")
  currentValuationAsOf     DateTime? @map("current_valuation_as_of") @db.Date

  // HMO licensing
  hmoLicenceKind           String?   @map("hmo_licence_kind") // none|mandatory|additional|selective
  hmoLicenceRef            String?   @map("hmo_licence_ref")
  hmoLicenceExpiry         DateTime? @map("hmo_licence_expiry") @db.Date
  hmoPermittedOccupancy    Int?      @map("hmo_permitted_occupancy")

  // Energy
  epcRating                String?   @map("epc_rating") // A|B|C|D|E|F|G
  epcExpiry                DateTime? @map("epc_expiry") @db.Date

  // Planning
  article4Area             Boolean   @default(false) @map("article_4_area")

  // AASC potential
  isAascProperty           Boolean   @default(false) @map("is_aasc_property")

  notes                    String?

  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation             Organisation @relation(fields: [organisationId], references: [id])
  entity                   Entity @relation(fields: [entityId], references: [id])
  units                    Unit[]
  mortgages                Mortgage[]
  valuations               Valuation[]
  tenancies                Tenancy[]
  complianceItems          ComplianceItem[]
  maintenanceJobs          MaintenanceJob[]
  documents                Document[]
  aascPlacements           AascPlacement[]
  transactions             Transaction[]

  @@map("properties")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([entityId])
  @@index([postcode])
}

model Unit {
  id              String    @id @default(uuid()) @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  label           String    // "Room 1", "Flat A", "Bedroom 2"
  bedrooms        Int       @default(1)
  bathroomsEnsuite Boolean  @default(false) @map("bathrooms_ensuite")
  floorAreaSqm    Decimal?  @map("floor_area_sqm") @db.Decimal(6, 2)
  marketRentPence BigInt?   @map("market_rent_pence")
  status          String    @default("vacant") // occupied|vacant|reserved|maintenance|offline
  notes           String?

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  property        Property @relation(fields: [propertyId], references: [id])
  tenancies       Tenancy[]

  @@unique([propertyId, label])
  @@map("units")
  @@index([propertyId])
}

model Tenant {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  email           String?
  phone           String?
  rightToRentChecked Boolean @default(false) @map("right_to_rent_checked")
  rightToRentExpiry DateTime? @map("right_to_rent_expiry") @db.Date
  notes           String?

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])
  tenancies       Tenancy[]
  tenancyTenants  TenancyTenant[]

  @@map("tenants")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
}

model Tenancy {
  id                  String    @id @default(uuid()) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  propertyId          String    @map("property_id") @db.Uuid
  unitId              String?   @map("unit_id") @db.Uuid
  tenantId            String?   @map("tenant_id") @db.Uuid

  kind                String    // ast|licence|aasc_placement|company_let|holiday_let
  startDate           DateTime  @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  endDateIntended     DateTime? @map("end_date_intended") @db.Date
  noticeGivenAt       DateTime? @map("notice_given_at") @db.Date
  vacateDate          DateTime? @map("vacate_date") @db.Date
  rentPence           BigInt    @map("rent_pence")
  rentPeriod          String    @default("monthly") @map("rent_period") // monthly|weekly|four_weekly|annual
  depositPence        BigInt?   @map("deposit_pence")
  depositSchemeRef    String?   @map("deposit_scheme_ref")
  depositScheme       String?   @map("deposit_scheme") // dps|mydeposits|tds|none

  // AASC-specific
  aascPlacementRef    String?   @map("aasc_placement_ref")
  aascContractor      String?   @map("aasc_contractor") // clearsprings|serco

  status              String    @default("active") // active|ended|notice_given
  notes               String?

  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation        Organisation @relation(fields: [organisationId], references: [id])
  property            Property @relation(fields: [propertyId], references: [id])
  unit                Unit? @relation(fields: [unitId], references: [id])
  tenant              Tenant? @relation(fields: [tenantId], references: [id])
  tenancyTenants      TenancyTenant[]
  rentChanges         RentChange[]
  aascPlacement       AascPlacement?

  @@map("tenancies")
  @@index([organisationId])
  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId])
  @@index([startDate])
  @@index([organisationId, status])
}

model TenancyTenant {
  // Join table for joint tenancies — supports up to 4 joint tenants in the
  // UI, unlimited at DB. The single `tenancy.tenantId` FK stays for the
  // lead tenant (back-compat with M2 code); rows here cover additional
  // joint tenants.
  id          String    @id @default(uuid()) @db.Uuid
  tenancyId   String    @map("tenancy_id") @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenancy     Tenancy @relation(fields: [tenancyId], references: [id])
  tenant      Tenant  @relation(fields: [tenantId], references: [id])

  @@map("tenancy_tenants")
  @@unique([tenancyId, tenantId])
  @@index([tenancyId])
  @@index([tenantId])
}

model RentChange {
  // Every tenancy gets at least one row on creation
  //   (effective_from = start_date, new_rent_pence = initial rent)
  // so rent-over-time queries don't have to special-case "initial".
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  tenancyId       String    @map("tenancy_id") @db.Uuid

  effectiveFrom   DateTime  @map("effective_from") @db.Date
  newRentPence    BigInt    @map("new_rent_pence")
  newRentPeriod   String    @map("new_rent_period") // monthly|weekly|four_weekly|annual
  reason          String    // initial|review|regeared|arrears_negotiation|adjustment
  notes           String?

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])
  tenancy         Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@map("rent_changes")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([tenancyId])
  @@index([tenancyId, effectiveFrom])
}

// =========================================================================
// Finance: mortgages, valuations, transactions, director loans, capital accounts
// =========================================================================

model Mortgage {
  id                       String    @id @default(uuid()) @db.Uuid
  organisationId           String    @map("organisation_id") @db.Uuid
  propertyId               String    @map("property_id") @db.Uuid

  lender                   String
  accountRef               String?   @map("account_ref")
  originalLoanPence        BigInt    @map("original_loan_pence")
  currentBalancePence      BigInt    @map("current_balance_pence")
  interestRateBps          Int       @map("interest_rate_bps")
  monthlyPaymentPence      BigInt    @map("monthly_payment_pence")
  product                  String    // fixed|tracker|svr|discount|bridging|development
  fixedEndDate             DateTime? @map("fixed_end_date") @db.Date
  termMonths               Int       @map("term_months")
  isInterestOnly           Boolean   @default(false) @map("is_interest_only")
  broker                   String?
  notes                    String?

  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation             Organisation @relation(fields: [organisationId], references: [id])
  property                 Property @relation(fields: [propertyId], references: [id])
  events                   MortgageEvent[]

  @@map("mortgages")
  @@index([organisationId])
  @@index([propertyId])
  @@index([fixedEndDate])
}

model MortgageEvent {
  id              String    @id @default(uuid()) @db.Uuid
  mortgageId      String    @map("mortgage_id") @db.Uuid
  eventDate       DateTime  @map("event_date") @db.Date
  kind            String    // drawdown|payment|rate_change|product_switch|redemption|er_charge
  balancePence    BigInt?   @map("balance_pence")
  ratePostBps     Int?      @map("rate_post_bps")
  amountPence     BigInt?   @map("amount_pence")
  notes           String?

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  mortgage        Mortgage @relation(fields: [mortgageId], references: [id])

  @@map("mortgage_events")
  @@index([mortgageId])
}

model Valuation {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid

  valuationDate   DateTime  @map("valuation_date") @db.Date
  valuePence      BigInt    @map("value_pence")
  kind            String    // estimate|estate_agent|red_book|refinance|purchase|desktop
  source          String?   // surveyor name / portal / "Owner estimate"
  notes           String?

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])
  property        Property @relation(fields: [propertyId], references: [id])

  @@map("valuations")
  @@index([organisationId])
  @@index([propertyId])
  @@index([valuationDate])
}

model Transaction {
  id                  String    @id @default(uuid()) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  bankAccountId       String?   @map("bank_account_id") @db.Uuid
  propertyId          String?   @map("property_id") @db.Uuid
  entityId            String?   @map("entity_id") @db.Uuid

  postedAt            DateTime  @map("posted_at") @db.Date
  description         String
  amountPence         BigInt    @map("amount_pence") // positive = credit, negative = debit
  categoryCode        String    @map("category_code") // rent|mortgage_payment|maintenance|insurance|... see lib/domain/transactions
  reference           String?
  externalId          String?   @map("external_id") // bank-export identifier for dedup
  reconciledAt        DateTime? @map("reconciled_at") @db.Timestamptz(6)
  importBatchId       String?   @map("import_batch_id") @db.Uuid
  splitParentId       String?   @map("split_parent_id") @db.Uuid

  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation        Organisation @relation(fields: [organisationId], references: [id])
  bankAccount         BankAccount? @relation(fields: [bankAccountId], references: [id])
  property            Property?    @relation(fields: [propertyId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  splitParent         Transaction? @relation("TransactionSplit", fields: [splitParentId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  splitChildren       Transaction[] @relation("TransactionSplit")

  @@map("transactions")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([organisationId, postedAt])
  @@index([propertyId])
  @@index([entityId])
  @@index([postedAt])
  @@index([categoryCode])
  @@index([splitParentId])
  @@unique([bankAccountId, externalId])
}

model TransactionCategoryRule {
  // Memory: "when description matches X, categorise as Y (and optionally
  // associate property P)". First-match-wins; rules are tried oldest
  // (highest hit count) first so frequent matches stay cheap.
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid

  pattern         String
  isRegex         Boolean   @default(false) @map("is_regex")
  signRequired    String?   @map("sign_required") // credit|debit|null
  categoryCode    String    @map("category_code")
  propertyId      String?   @map("property_id") @db.Uuid

  hitCount        Int       @default(0) @map("hit_count")
  lastMatchedAt   DateTime? @map("last_matched_at") @db.Timestamptz(6)

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])

  @@map("transaction_category_rules")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([organisationId, hitCount(sort: Desc)])
}

model TransactionImport {
  // CSV-upload batch. Rows land in transaction_import_rows in the
  // 'pending' state; user reviews + commits, which copies them into
  // `transactions` and flips the import to 'committed'.
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  bankAccountId   String    @map("bank_account_id") @db.Uuid
  uploadedByUserId String?  @map("uploaded_by_user_id") @db.Uuid

  filename        String
  format          String    // monzo|starling|hsbc|generic
  rowCount        Int       @default(0) @map("row_count")
  // pending|previewing|committed|rejected
  status          String    @default("pending")
  committedAt     DateTime? @map("committed_at") @db.Timestamptz(6)
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz(6)

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])
  rows            TransactionImportRow[]

  @@map("transaction_imports")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([bankAccountId])
  @@index([status])
}

model TransactionImportRow {
  // A staged row. After parse, before commit. Auto-categorisation
  // result populates category_code + property_id; the user can
  // override either in the preview UI before commit.
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  importId        String    @map("import_id") @db.Uuid

  rowIndex        Int       @map("row_index")
  postedAt        DateTime  @map("posted_at") @db.Date
  description     String
  amountPence     BigInt    @map("amount_pence")
  externalId      String?   @map("external_id")
  reference       String?

  // Auto-categorisation result. Overridden by user pre-commit.
  categoryCode    String    @default("uncategorised") @map("category_code")
  propertyId      String?   @map("property_id") @db.Uuid

  // 'pending' until commit; 'duplicate' if matched against an existing
  // transaction; 'skipped' if the user marked it skip; 'committed'
  // when copied into transactions.
  status          String    @default("pending")
  duplicateOfTransactionId String? @map("duplicate_of_transaction_id") @db.Uuid

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])
  import          TransactionImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@map("transaction_import_rows")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([importId])
  @@index([importId, rowIndex])
  @@unique([importId, rowIndex])
}

model DirectorLoan {
  id                String    @id @default(uuid()) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid
  entityId          String    @map("entity_id") @db.Uuid
  directorName      String    @map("director_name")
  eventDate         DateTime  @map("event_date") @db.Date
  kind              String    // loan_in|loan_out|interest_accrued|repayment
  amountPence       BigInt    @map("amount_pence")
  description       String?

  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation      Organisation @relation(fields: [organisationId], references: [id])
  entity            Entity @relation(fields: [entityId], references: [id])

  @@map("director_loans")
  @@index([organisationId])
  @@index([entityId])
}

// =========================================================================
// Investor capital accounts (M11). Three-table model: Investor (the
// legal person / SPV), InvestorCapitalAccount (investor × entity with
// terms), InvestorTransaction (the signed ledger). The foundation's
// flat single-table model was dropped in 20260515000012_m11_investors.
// =========================================================================

model Investor {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid

  name            String
  kind            String    // individual|entity|spv
  contactEmail    String?   @map("contact_email")
  contactPhone    String?   @map("contact_phone")
  addressLine1    String?   @map("address_line_1")
  addressLine2    String?   @map("address_line_2")
  city            String?
  postcode        String?
  country         String?   @default("GB")

  // KYC fields — restricted to owner/admin reads in app code. The DB
  // layer doesn't redact (RLS is row-level, not column-level); the
  // route handler omits these fields for non-admin roles and writes
  // an investor_kyc_log row when admins read them.
  taxId           String?   @map("tax_id")
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  nationalIdKind  String?   @map("national_id_kind")
  notes           String?

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])
  accounts        InvestorCapitalAccount[]
  kycLogs         InvestorKycLog[]

  @@map("investors")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
}

model InvestorCapitalAccount {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  investorId      String    @map("investor_id") @db.Uuid
  entityId        String    @map("entity_id") @db.Uuid

  kind            String    // preferred_equity|common_equity|mezzanine_loan|straight_loan
  terms           Json      @default("{}")
  commitmentPence BigInt    @map("commitment_pence")
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  status          String    @default("open") // open|closed|defaulted

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])
  investor        Investor @relation(fields: [investorId], references: [id])
  entity          Entity @relation(fields: [entityId], references: [id])
  transactions    InvestorTransaction[]

  @@map("investor_capital_accounts")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([investorId])
  @@index([entityId])
}

model InvestorTransaction {
  id                  String    @id @default(uuid()) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  accountId           String    @map("account_id") @db.Uuid

  kind                String    // contribution|distribution|interest_accrual|fee|redemption|adjustment
  transactionDate     DateTime  @map("transaction_date") @db.Date
  // Signed: contributions positive, distributions negative.
  amountPence         BigInt    @map("amount_pence")
  linkedTransactionId String?   @map("linked_transaction_id") @db.Uuid
  sourceDocumentId    String?   @map("source_document_id") @db.Uuid
  notes               String?

  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation        Organisation @relation(fields: [organisationId], references: [id])
  account             InvestorCapitalAccount @relation(fields: [accountId], references: [id])

  @@map("investor_transactions")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([accountId])
  @@index([accountId, transactionDate])
}

model InvestorKycLog {
  id              BigInt    @id @default(autoincrement())
  organisationId  String    @map("organisation_id") @db.Uuid
  investorId      String    @map("investor_id") @db.Uuid
  actorUserId     String?   @map("actor_user_id") @db.Uuid
  accessedField   String    @map("accessed_field")
  accessedAt      DateTime  @default(now()) @map("accessed_at") @db.Timestamptz(6)

  investor        Investor @relation(fields: [investorId], references: [id])

  @@map("investor_kyc_log")
  @@index([organisationId])
  @@index([investorId])
  @@index([accessedAt(sort: Desc)])
}

// =========================================================================
// Compliance, maintenance, tasks
// =========================================================================

model ComplianceItem {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  unitId          String?   @map("unit_id") @db.Uuid

  kind            String    // gas_safety|eicr|epc|hmo_licence|fire_alarm|emergency_lighting|pat|legionella|insurance|asbestos|fire_risk_assessment|other
  issueDate       DateTime? @map("issue_date") @db.Date
  expiryDate      DateTime? @map("expiry_date") @db.Date
  status          String    // valid|expiring|expired|missing|exempt
  issuer          String?
  documentId      String?   @map("document_id") @db.Uuid
  notes           String?

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])
  property        Property     @relation(fields: [propertyId], references: [id])

  @@map("compliance_items")
  @@index([organisationId])
  @@index([propertyId])
  @@index([expiryDate])
  @@index([kind])
}

model Contractor {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  entityId        String?   @map("entity_id") @db.Uuid // if it's also one of your sister entities
  name            String
  kind            String    // plumber|electrician|gas_safe|… — see CONTRACTOR_KINDS in lib/schemas
  contactName     String?   @map("contact_name")
  phone           String?
  email           String?
  insuranceExpiry DateTime? @map("insurance_expiry") @db.Date
  accreditations  String[]  @default([]) // gas_safe_register | NICEIC | …
  notes           String?

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])
  jobs            MaintenanceJob[]
  quotes          MaintenanceQuote[]
  invoices        MaintenanceInvoice[]

  @@map("contractors")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([insuranceExpiry])
}

model MaintenanceJob {
  id                       String    @id @default(uuid()) @db.Uuid
  organisationId           String    @map("organisation_id") @db.Uuid
  propertyId               String    @map("property_id") @db.Uuid
  unitId                   String?   @map("unit_id") @db.Uuid
  tenancyId                String?   @map("tenancy_id") @db.Uuid
  reportedByUserId         String?   @map("reported_by_user_id") @db.Uuid
  reportedByTenantId       String?   @map("reported_by_tenant_id") @db.Uuid

  kind                     String    @default("repair") // repair|planned_maintenance|inspection|cleaning|statutory|emergency
  title                    String
  description              String?
  priority                 String    @default("normal") // emergency|urgent|normal|low
  status                   String    @default("reported")
  // reported|triaged|awaiting_quote|quote_received|approved|
  // scheduled|in_progress|awaiting_invoice|completed|cancelled

  reportedAt               DateTime  @default(now()) @map("reported_at") @db.Timestamptz(6)
  reportedDate             DateTime  @map("reported_date") @db.Date
  targetCompletionDate     DateTime? @map("target_completion_date") @db.Date
  completedAt              DateTime? @map("completed_at") @db.Timestamptz(6)
  completedDate            DateTime? @map("completed_date") @db.Date

  assignedContractorId     String?   @map("assigned_contractor_id") @db.Uuid
  contractorName           String?   @map("contractor_name") // legacy; use assignedContractor
  costEstimatePence        BigInt?   @map("cost_estimate_pence")
  costActualPence          BigInt?   @map("cost_actual_pence")
  costPence                BigInt?   @map("cost_pence") // final cost on completion

  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation             Organisation @relation(fields: [organisationId], references: [id])
  property                 Property     @relation(fields: [propertyId], references: [id])
  assignedContractor       Contractor?  @relation(fields: [assignedContractorId], references: [id])
  events                   MaintenanceJobEvent[]
  quotes                   MaintenanceQuote[]
  invoices                 MaintenanceInvoice[]

  @@map("maintenance_jobs")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([organisationId, status])
  @@index([organisationId, priority])
  @@index([assignedContractorId])
  @@index([propertyId])
  @@index([status])
}

model MaintenanceJobEvent {
  // Append-only timeline of everything that happened on a job.
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  jobId           String    @map("job_id") @db.Uuid
  actorUserId     String?   @map("actor_user_id") @db.Uuid
  kind            String    // status_change|note_added|quote_received|invoice_received|contractor_assigned|tenant_message
  body            String?
  metadata        Json      @default("{}")

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])
  job             MaintenanceJob @relation(fields: [jobId], references: [id])

  @@map("maintenance_job_events")
  @@index([organisationId])
  @@index([jobId])
  @@index([jobId, createdAt])
}

model MaintenanceQuote {
  id                  String    @id @default(uuid()) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  jobId               String    @map("job_id") @db.Uuid
  contractorId        String    @map("contractor_id") @db.Uuid
  amountPence         BigInt    @map("amount_pence")
  validityUntil       DateTime? @map("validity_until") @db.Date
  receivedAt          DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  status              String    @default("pending") // pending|accepted|declined|expired
  notes               String?
  sourceDocumentId    String?   @map("source_document_id") @db.Uuid

  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation        Organisation @relation(fields: [organisationId], references: [id])
  job                 MaintenanceJob @relation(fields: [jobId], references: [id])
  contractor          Contractor @relation(fields: [contractorId], references: [id])

  @@map("maintenance_quotes")
  @@index([organisationId])
  @@index([jobId])
  @@index([contractorId])
}

model MaintenanceInvoice {
  id                  String    @id @default(uuid()) @db.Uuid
  organisationId      String    @map("organisation_id") @db.Uuid
  jobId               String    @map("job_id") @db.Uuid
  contractorId        String    @map("contractor_id") @db.Uuid
  amountPence         BigInt    @map("amount_pence")
  vatPence            BigInt    @default(0) @map("vat_pence")
  invoiceNumber       String    @map("invoice_number")
  invoiceDate         DateTime  @map("invoice_date") @db.Date
  paidAt              DateTime? @map("paid_at") @db.Timestamptz(6)
  transactionId       String?   @map("transaction_id") @db.Uuid
  sourceDocumentId    String?   @map("source_document_id") @db.Uuid

  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation        Organisation @relation(fields: [organisationId], references: [id])
  job                 MaintenanceJob @relation(fields: [jobId], references: [id])
  contractor          Contractor @relation(fields: [contractorId], references: [id])

  @@map("maintenance_invoices")
  @@unique([organisationId, contractorId, invoiceNumber])
  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([jobId])
  @@index([contractorId])
  @@index([transactionId])
}

model Task {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  title           String
  description     String?
  dueDate         DateTime? @map("due_date") @db.Date
  assigneeUserId  String?   @map("assignee_user_id") @db.Uuid
  status          String    @default("open") // open|in_progress|done|cancelled
  relatedKind     String?   @map("related_kind") // property|tenancy|compliance|mortgage|...
  relatedId       String?   @map("related_id") @db.Uuid

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])

  @@map("tasks")
  @@index([organisationId])
  @@index([assigneeUserId])
}

model Reminder {
  id                String    @id @default(uuid()) @db.Uuid
  organisationId    String    @map("organisation_id") @db.Uuid

  relatedKind       String    @map("related_kind") // compliance|mortgage|tenancy|insurance
  relatedId         String    @map("related_id") @db.Uuid
  // Days from event (positive = before, negative = after).
  // Idempotency: a given (related_kind, related_id, days_until_event)
  // can only ever produce one reminder row per organisation.
  daysUntilEvent    Int       @map("days_until_event")
  triggerAt         DateTime  @map("trigger_at") @db.Timestamptz(6)

  // Template registry key (see lib/email/templates). Body is rendered
  // at send time from the latest context, not at enqueue time, so
  // late-arriving data (e.g. issuer name) is included.
  bodyKey           String    @map("body_key")
  context           Json      @default("{}")

  channel           String    @default("email") // email|in_app
  status            String    @default("pending") // pending|claimed|sent|failed|superseded
  claimedAt         DateTime? @map("claimed_at") @db.Timestamptz(6)
  claimedBy         String?   @map("claimed_by")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  failedAt          DateTime? @map("failed_at") @db.Timestamptz(6)
  failureReason     String?   @map("failure_reason")
  retryCount        Int       @default(0) @map("retry_count")

  // Legacy: kept nullable so the older Prisma model doesn't break
  // existing seeded rows. Cron path uses bodyKey + context + render
  // instead.
  subject           String?
  body              String?

  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation      Organisation @relation(fields: [organisationId], references: [id])

  @@map("reminders")
  @@unique([organisationId, relatedKind, relatedId, daysUntilEvent])
  @@index([organisationId])
  @@index([triggerAt])
  @@index([status, triggerAt])
  @@index([relatedKind, relatedId])
}

model CronRunLog {
  // Observability for the cron pipeline. One row per invocation.
  // Started by the route handler on entry, updated on exit. If the
  // run process is killed mid-way, the row stays in 'running' state —
  // surface those as alerts on the admin page.
  id              BigInt    @id @default(autoincrement())
  job             String    // 'send-reminders' | 'enqueue-compliance-reminders' | …
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  status          String    @default("running") // running|ok|failed
  processed       Int       @default(0)
  failed          Int       @default(0)
  notes           String?
  errorMessage    String?   @map("error_message")

  @@map("cron_run_log")
  @@index([job, startedAt(sort: Desc)])
  @@index([status])
}

// =========================================================================
// Documents & audit
// =========================================================================

model Document {
  id                       String    @id @default(uuid()) @db.Uuid
  organisationId           String    @map("organisation_id") @db.Uuid
  propertyId               String?   @map("property_id") @db.Uuid
  unitId                   String?   @map("unit_id") @db.Uuid
  tenancyId                String?   @map("tenancy_id") @db.Uuid
  mortgageId               String?   @map("mortgage_id") @db.Uuid

  storagePath              String    @map("storage_path")
  filename                 String
  mimeType                 String    @map("mime_type")
  sizeBytes                BigInt    @map("size_bytes")
  uploadedByUserId         String?   @map("uploaded_by_user_id") @db.Uuid
  uploadedAt               DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  kind                     String?   // see DOCUMENT_KINDS in lib/schemas/document.ts

  // Pipeline state. Status flows:
  //   uploaded -> ocr_running -> ocr_complete -> (confirmed | rejected)
  //                            \-> ocr_failed
  status                   String    @default("uploaded")
  ocrConfidenceBps         Int?      @map("ocr_confidence_bps")
  ocrText                  String?   @map("ocr_text")
  confidenceBps            Int?      @map("confidence_bps")
  extractedJson            Json?     @map("extracted_json")
  ocrFailureReason         String?   @map("ocr_failure_reason")

  confirmedByUserId        String?   @map("confirmed_by_user_id") @db.Uuid
  confirmedAt              DateTime? @map("confirmed_at") @db.Timestamptz(6)
  rejectedAt               DateTime? @map("rejected_at") @db.Timestamptz(6)
  derivedComplianceItemId  String?   @map("derived_compliance_item_id") @db.Uuid

  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation             Organisation @relation(fields: [organisationId], references: [id])
  property                 Property?    @relation(fields: [propertyId], references: [id])

  @@map("documents")
  @@index([organisationId])
  @@index([organisationId, deletedAt])
  @@index([organisationId, status])
  @@index([propertyId])
  @@index([kind])
  @@index([derivedComplianceItemId])
}

model AuditLog {
  id              BigInt    @id @default(autoincrement())
  actorUserId     String?   @map("actor_user_id") @db.Uuid
  organisationId  String?   @map("organisation_id") @db.Uuid
  action          String    // INSERT|UPDATE|DELETE
  tableName       String    @map("table_name")
  rowId           String    @map("row_id") @db.Uuid
  before          Json?
  after           Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_log")
  @@index([tableName, rowId])
  @@index([actorUserId])
  @@index([organisationId])
  @@index([createdAt])
}

// =========================================================================
// Billing (M12)
// =========================================================================

model Subscription {
  // Mirrors what Stripe sends. Owner-only writes through the webhook
  // handler in app/api/webhooks/stripe/ (an allowed service-role path).
  id                    String    @id @default(uuid()) @db.Uuid
  organisationId        String    @map("organisation_id") @db.Uuid

  stripeSubscriptionId  String    @unique @map("stripe_subscription_id")
  stripePriceId         String    @map("stripe_price_id")
  status                String    // trialing|active|past_due|canceled|paused|incomplete|incomplete_expired|unpaid
  currentPeriodStart    DateTime  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd      DateTime  @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd     Boolean   @default(false) @map("cancel_at_period_end")
  metadata              Json      @default("{}")

  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation          Organisation @relation(fields: [organisationId], references: [id])

  @@map("subscriptions")
  @@index([organisationId])
  @@index([organisationId, status])
}

model WebhookEvent {
  // Idempotency log for inbound Stripe (and future) webhooks.
  // Inserted as the FIRST action in the handler — if the event_id
  // already exists, the handler returns 200 and skips replay.
  //
  // organisationId is set best-effort at insert time by the handler
  // (resolveOrgIdForEvent). Nullable for events that aren't
  // attributable yet (e.g. customer.created without metadata).
  // /admin/webhook-events filters by it; events with NULL never
  // appear on the page.
  id              String        @id @default(uuid()) @db.Uuid
  organisationId  String?       @map("organisation_id") @db.Uuid
  provider        String        // stripe
  eventId         String        @unique @map("event_id")
  eventType       String        @map("event_type")
  payload         Json
  processedAt     DateTime?     @map("processed_at") @db.Timestamptz(6)
  error           String?

  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation    Organisation? @relation(fields: [organisationId], references: [id])

  @@map("webhook_events")
  @@index([eventType])
  @@index([provider, processedAt])
  @@index([organisationId, createdAt(sort: Desc)])
}

model UsageLog {
  // Append-only usage meter. Metric currently used:
  //   ocr_runs           — incremented by the OCR job (M7).
  //   documents_uploaded — incremented by document upload action (M7).
  id              BigInt    @id @default(autoincrement())
  organisationId  String    @map("organisation_id") @db.Uuid
  metric          String    // ocr_runs|documents_uploaded
  at              DateTime  @default(now()) @db.Timestamptz(6)
  count           Int       @default(1)

  @@map("usage_log")
  @@index([organisationId, metric, at])
}

// =========================================================================
// AASC
// =========================================================================

model AascContract {
  id                          String    @id @default(uuid()) @db.Uuid
  organisationId              String    @map("organisation_id") @db.Uuid
  entityId                    String?   @map("entity_id") @db.Uuid
  contractor                  String    // clearsprings|serco
  kind                        String    // direct_lease|supply_agreement
  reference                   String?
  startDate                   DateTime  @map("start_date") @db.Date
  endDate                     DateTime? @map("end_date") @db.Date
  breakClauseDate             DateTime? @map("break_clause_date") @db.Date
  contractedRatePencePerWeek  BigInt?   @map("contracted_rate_pence_per_week")
  commissionRateBps           Int       @default(0) @map("commission_rate_bps")
  paymentTermsDays            Int       @default(30) @map("payment_terms_days")
  status                      String    @default("active") // active|expired|suspended|terminated
  payableBankAccountId        String?   @map("payable_bank_account_id") @db.Uuid
  monthlyHeadlinePence        BigInt?   @map("monthly_headline_pence")
  notes                       String?

  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                   DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation                Organisation @relation(fields: [organisationId], references: [id])
  placements                  AascPlacement[]

  @@map("aasc_contracts")
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([breakClauseDate])
  @@index([endDate])
}

model AascArea {
  // Global (not tenant-scoped) — operated by admin tooling, read by all orgs.
  // RLS allows authenticated select; insert/update restricted to service role.
  id              String    @id @default(uuid()) @db.Uuid
  contractor      String    // clearsprings|serco
  localAuthority  String    @map("local_authority")
  status          String?   // open|limited|closed|unknown (Serco) — null for Clearsprings
  demandPending   Int?      @map("demand_pending") // Clearsprings demand-gap beds
  pipeline        Int?
  note            String?
  effectiveDate   DateTime  @map("effective_date") @db.Date

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("aasc_areas")
  @@unique([contractor, localAuthority, effectiveDate])
  @@index([contractor, localAuthority])
}

model AascPlacement {
  // ##########################################################################
  // # Hard rule (data-protection contract w/ Clearsprings + Serco):
  // # NO service-user identity columns. EVER. No name, full_name, first_name,
  // # last_name, dob, date_of_birth, nationality, passport, passport_number,
  // # national_id. The M8 reminder-engine migration includes a DO-block guard
  // # that fails any future migration trying to add one.
  // ##########################################################################
  id                          String    @id @default(uuid()) @db.Uuid
  organisationId              String    @map("organisation_id") @db.Uuid
  contractId                  String?   @map("contract_id") @db.Uuid
  tenancyId                   String?   @unique @map("tenancy_id") @db.Uuid
  propertyId                  String    @map("property_id") @db.Uuid
  unitId                      String?   @map("unit_id") @db.Uuid

  placementRef                String    @map("placement_ref")
  weeklyRatePence             BigInt    @map("weekly_rate_pence")
  commissionRateBpsOverride   Int?      @map("commission_rate_bps_override")
  serviceUserCount            Int       @default(1) @map("service_user_count")
  startDate                   DateTime  @map("start_date") @db.Date
  endDateExpected             DateTime? @map("end_date_expected") @db.Date
  endDate                     DateTime? @map("end_date") @db.Date
  status                      String    @default("active") // active|ended|terminated

  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation        Organisation @relation(fields: [organisationId], references: [id])
  contract            AascContract? @relation(fields: [contractId], references: [id])
  tenancy             Tenancy? @relation(fields: [tenancyId], references: [id])
  property            Property @relation(fields: [propertyId], references: [id])

  @@map("aasc_placements")
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, deletedAt])
  @@index([propertyId])
  @@index([contractId])
  @@index([unitId])
}

model PlacementCountChange {
  // Append-only log of how the service_user_count on a placement
  // changed over time, so historical revenue analytics are exact.
  // No identity columns here either.
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  placementId     String    @map("placement_id") @db.Uuid
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  newCount        Int       @map("new_count")
  reason          String?

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id])

  @@map("placement_count_changes")
  @@index([organisationId])
  @@index([placementId])
  @@index([placementId, effectiveFrom])
}

model LhaRate {
  // Global reference data — same RLS pattern as aasc_areas.
  id              String    @id @default(uuid()) @db.Uuid
  brmaCode        String    @map("brma_code")
  beds            String    // SAR|1B|2B|3B|4B
  weeklyPence     BigInt    @map("weekly_pence")
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("lha_rates")
  @@unique([brmaCode, beds, effectiveFrom])
  @@index([brmaCode, beds])
}
